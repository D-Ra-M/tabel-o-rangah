{
  "name": "tabel-o-rangah",
  "version": "1.1.0",
  "private": true,
  "description": "Табель о рангах — PWA для таблиц оценок и рейтингов",
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-project.js",
    "test:e2e": "node tests/e2e/run.js",
    "verify": "npm run lint && npm run check && npm test"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "playwright": "^1.50.0"
  },
  "engines": {
    "node": ">=20"
  }
}
